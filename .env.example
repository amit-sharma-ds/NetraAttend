# Cloud server settings. Copy to .env and fill in (never share .env).

# your free DuckDNS name, e.g. netraattend.duckdns.org
DOMAIN=yourname.duckdns.org

# same MongoDB as the office PC
NETRA_MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
NETRA_MONGO_DB=netraattend

# long random text (any 60+ characters) and a STRONG admin password
NETRA_SECRET_KEY=change-me-to-a-long-random-string
NETRA_ADMIN_USER=admin
NETRA_ADMIN_PASSWORD=change-me

# admin pages from the internet: False = allowed (needs the strong password above),
# True = admin only on the office PC's website
NETRA_ADMIN_LAN_ONLY=False

NETRA_ROLE=web
